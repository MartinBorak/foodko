rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Who may use the app: a document per e-mail address in the `allowlist` collection,
    // e.g. allowlist/alice@example.com (any fields; `name` is handy). Maintained in the Firebase
    // console, never from the app, so the repo contains no personal data.
    function isAllowlisted() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email));
    }

    function isOwner(uid) {
      return isAllowlisted() && request.auth.uid == uid;
    }

    // The allowlist itself is invisible to clients.
    match /allowlist/{email} {
      allow read, write: if false;
    }

    // Shared food database. No ownership checks between the allowed users.
    match /foods/{foodId} {
      allow read, write: if isAllowlisted();
    }

    // Everything under a user is private to that user.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
